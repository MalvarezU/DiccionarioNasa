# MariaDB — BD principal (prod: MariaDB gestionada de Hostinger; local: puerto 3307)
# Ver docs/Guia_Arranque_Despliegue.md
DATABASE_URL="mysql://test:test@localhost:3307/piiyaak"

# Supabase — LEGACY, deprecado (era Postgres). No configurar en instalaciones
# nuevas. Solo necesario para correr una vez los scripts de migración puntual
# prisma/migrate-audio-urls.ts y prisma/migrate-media-to-r2.ts contra datos viejos.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service_role_key_de_supabase"
# SUPABASE_BUCKET_AUDIOS="audios"

# Cloudflare R2 (media: imágenes + audios). Ver src/lib/r2.ts
# Token: Cloudflare → R2 → Manage API Tokens (permiso Object Read & Write)
R2_ACCOUNT_ID="tu_account_id"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET="piiyaak-media"
# URL pública del bucket (dominio custom o https://<bucket>.<id>.r2.dev)
R2_PUBLIC_BASE_URL="https://cdn.tudominio.com"
# Solo tests locales con MinIO. Vacío en prod y contra R2 real.
R2_ENDPOINT_OVERRIDE=""

# NextAuth
NEXTAUTH_SECRET="REEMPLAZAR-con-openssl-rand-base64-32"
# Local: http://localhost:3000 · Prod: el dominio de Hostinger
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (B1.3, opcional: sin esto solo funciona email/contraseña)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email transaccional Resend (B1.2/B1.4, obligatorio en producción)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Piiyaak <hola@piiyaak.com>"

# Admin (opcional, hay defaults en prisma/seed.ts)
ADMIN_EMAIL="admin@nasayuwe.com"
ADMIN_PASSWORD="AdminNasa2024!"
ADMIN_NAME="Administrador"
