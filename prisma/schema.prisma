// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // Hashed password (bcrypt)
  role      String   @default("user") // "user" | "editor" | "admin"
  emailVerified DateTime? // B1.2: verificación obligatoria (backfill en migración)
  onboardedAt   DateTime? // Fase Google-first: onboarding post-registro (null = pendiente)
  verifyToken   String?   @unique
  verifyExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites      Favorite[]
  viewHistory    ViewHistory[]
  searchHistory  SearchHistory[]
  passwordResets PasswordReset[]
  gameSessions   UserGameSession[]
  lessonProgress UserLessonProgress[]
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model UserGameSession {
  id         String   @id @default(cuid())
  userId     String?
  sessionKey String?
  game       String
  played     Int      @default(1)
  won        Int      @default(0)
  bestScore  Int      @default(0)
  bestStreak Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, game])
  @@index([sessionKey, game])
  @@unique([userId, game])
  @@unique([sessionKey, game])
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String? @db.Text
  /// Imagen de portada del catálogo (URL pública de R2, `images/...`).
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  sequential  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  modules Module[]
}

model Module {
  id        String    @id @default(cuid())
  courseId  String
  title     String
  order     Int       @default(0)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId, order])
  @@index([updatedAt])
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  title    String
  order    Int        @default(0)
  /// Numeración visible ("1.1", "1.2"...). Calculada por el server al crear
  /// y reasignada al reordenar.
  lessonNumber Int?
  /// Documento de bloques de la lección: { version, blocks[] }.
  /// Ver src/lib/courses/blocks.ts para el contrato y la validación.
  content  Json
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress UserLessonProgress[]

  @@index([moduleId, order])
  @@index([moduleId, lessonNumber])
  @@index([updatedAt])
}

model UserLessonProgress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean   @default(false)
  score         Int?
  lastVisitedAt DateTime  @default(now())
  completedAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model MediaAsset {
  /// Metadatos de archivos guardados en Cloudflare R2 (rama feat/r2-media).
  /// `data` (LONGBLOB) se eliminó: el binario vive en el bucket y acá solo
  /// la clave. Las URLs públicas se derivan con publicUrl(objectKey).
  id         String   @id @default(cuid())
  objectKey  String   @unique // "images/<uuid>.png" | "audios/<wordId>/..."
  filename   String
  /// MIME detectado por firma binaria, no el que declara el cliente.
  mimeType   String
  size       Int
  /// Hash SHA-256 hex (64 chars) sobre los bytes originales. Nullable hasta
  /// completar el backfill (Fase A, T09); el paso a NOT NULL pertenece a Fase B.
  sha256     String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

/// Marcador global de publicación (Fase A, decisión D2): una sola fila
/// `id = 1`. Cada mutación de contenido publicable ejecuta un `UPDATE`
/// atómico `version = version + 1`. El delta-sync real sigue por `updatedAt`
/// + keyset; la versión solo responde si la APK está atrasada.
/// `updatedAt` existe solo para auditoría, nunca como marcador.
model ContentVersion {
  id        Int      @id @default(1) // una sola fila, id = 1
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DictionaryWord {
  id              String   @id @default(cuid())
  spanish         String   // Word in Spanish
  nasaYuwe        String   // Word in Nasa Yuwe
  pronunciation   String?  // Written pronunciation guide
  audioUrl        String?  // URL to native speaker audio
  /// URL pública de la ilustración de la palabra (/api/media/[id]).
  /// Igual que audioUrl, es un string y no una relación: el binario vive en
  /// R2 (metadatos en MediaAsset, MariaDB) y se sirve por el mismo origen,
  /// así el service worker del PWA lo puede cachear sin conexión.
  illustrationUrl String?
  culturalContext String?  @db.Text // Cultural context of use
  category        String?  // Grammatical category (noun, verb, adj, etc.)
  examples        String?  @db.Text // Usage examples (JSON string)
  status          String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  favorites  Favorite[]
  viewHistory ViewHistory[]
  auditLogs  AuditLog[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model ViewHistory {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, createdAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // "CREATE" | "UPDATE" | "DELETE" | "IMPORT"
  entity    String   // "DictionaryWord" | etc.
  entityId  String?
  changes   String?  @db.LongText // JSON string with before/after
  userId    String?
  wordId    String?
  createdAt DateTime @default(now())

  word DictionaryWord? @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}
