// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // Hashed password (bcrypt)
  role      String   @default("user") // "user" | "editor" | "admin"
  emailVerified DateTime? // B1.2: verificación obligatoria (backfill en migración)
  verifyToken   String?   @unique
  verifyExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites      Favorite[]
  viewHistory    ViewHistory[]
  searchHistory  SearchHistory[]
  passwordResets PasswordReset[]
  gameSessions   UserGameSession[]
  lessonProgress UserLessonProgress[]
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum LessonType {
  READ
  QUIZ
  COMPLETE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model UserGameSession {
  id         String   @id @default(cuid())
  userId     String?
  sessionKey String?
  game       String
  played     Int      @default(1)
  won        Int      @default(0)
  bestScore  Int      @default(0)
  bestStreak Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, game])
  @@index([sessionKey, game])
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  sequential  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  modules Module[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int      @default(0)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  title    String
  type     LessonType @default(READ)
  order    Int        @default(0)
  wordId   String?
  payload  String?
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  word     DictionaryWord? @relation(fields: [wordId], references: [id], onDelete: SetNull)
  progress UserLessonProgress[]

  @@index([moduleId, order])
}

model UserLessonProgress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean   @default(false)
  score         Int?
  lastVisitedAt DateTime  @default(now())
  completedAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model DictionaryWord {
  id              String   @id @default(cuid())
  spanish         String   // Word in Spanish
  nasaYuwe        String   // Word in Nasa Yuwe
  pronunciation   String?  // Written pronunciation guide
  audioUrl        String?  // URL to native speaker audio
  culturalContext String?  // Cultural context of use
  category        String?  // Grammatical category (noun, verb, adj, etc.)
  examples        String?  // Usage examples (JSON string)
  status          String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  favorites  Favorite[]
  viewHistory ViewHistory[]
  auditLogs  AuditLog[]
  lessons    Lesson[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model ViewHistory {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, createdAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // "CREATE" | "UPDATE" | "DELETE" | "IMPORT"
  entity    String   // "DictionaryWord" | etc.
  entityId  String?
  changes   String?  // JSON string with before/after
  userId    String?
  wordId    String?
  createdAt DateTime @default(now())

  word DictionaryWord? @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}
